<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- A GUI-subsystem exe: no console window. The notification-area icon is its only surface. -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BenqBridge</AssemblyName>
    <RootNamespace>BenqBridge</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The Web SDK ships every project file as content. Keep internal folders out of any
         build or publish, even one run from this working folder instead of a clean clone. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);private-artifacts\**;ai\**;dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

</Project>
